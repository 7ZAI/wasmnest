package wasmnest:auth-client@0.0.1;

// 移动端能力域分片（WIT 按包拆分，ADR 0061）：一个能力域 = 一个独立包，
// 版本独立演进——本包 WIT 变更只 bump 本包，不波及未 import 它的应用。
// 端 `plugin` world 经 `include wasmnest:auth-client/cap-auth-client@0.0.1;` 并入本接口。

/// 设备入场认证引擎面（ABI v16 新增：认证 / 配对编排下沉）
///
/// **编排在本域的调用方插件，密码学与凭据在宿主**（C4 红线）：设备身份文件 /
/// JWT 持有 / `AuthHttpClient` / 生物凭证绑定与 Keystore 签名全部留在宿主
/// auth 引擎；本域只是把「对桌面端 `/api/auth/*` 六端点的引擎调用」投影给
/// 插件，流程顺序（请求配对 → 等码 → 验码 / QR / 生物挑战）由插件编排。
///
/// **凭据零过境**：认证成功后 JWT 由宿主 `apply_auth_success` 落地（global
/// token + 凭据表），本域**不向插件返回任何凭据材料**（token 不落插件）；前端持久化镜像经宿主窄读命令 `ws_get_auth_credentials`
/// 直接读引擎，不经插件。
///
/// 同步阻塞语义（与 `host-websocket.connect` 同款裁决）：host fn 在同步
/// 上下文执行，HTTP 往返会阻塞本插件实例直至完成或超时。
///
/// 权限位 `auth`（fail-closed，未声明即拒）：本域触发设备入场认证与凭据
/// 落地，是安全敏感面，不与任何既有能力混位。
///
/// 消费者：`com.wasmnest.bedcode`（配对 / 认证编排域）。
/// **为什么叫 client**：桌面分片曾声明同名 `host-auth`，但两者函数集**零交集**——
/// 桌面侧是「认证中心角色」（密钥托管 / 中心注册 / 组合式认证发现），本 interface 是
/// 「设备入场客户端」（配对 / 配对码 / QR / 生物凭证 / 凭据事实）。同名不同角色会在
/// 统一契约（并集 world）里撞 duplicate definition，故按角色定名：本侧 `-client`，
/// 桌面那侧 `host-auth-center`；两端各自注册自己承担的角色，Core 不做端点判定。
interface host-auth-client {
    /// 请求配对（HTTP `POST /api/auth/request-pairing`）：桌面端生成一次性
    /// 配对码并展示。Ok(()) = 桌面端受理（进入等码态）；Err = 网络故障 /
    /// 桌面端拒绝（透传原因）
    request-pairing: func() -> result<_, string>;
    /// 验证配对码（HTTP `POST /api/auth/verify-pairing-code`）。
    /// Ok(true) = 受理且凭据已落地宿主；Ok(false) = 桌面端业务拒绝
    /// （码无效 / 过期等）；Err = 网络故障（透传原因）
    verify-pairing-code: func(code: string) -> result<bool, string>;
    /// QR token 认证（HTTP `POST /api/auth/qr-connect`）。结果语义同
    /// verify-pairing-code
    qr-connect: func(token: string) -> result<bool, string>;
    /// 生物认证登录（HTTP 挑战-应答握手 + Keystore 签名，全在宿主执行）。
    /// Ok(false) = 本地生物验证未通过 / 用户取消；Ok(true) = 受理。
    /// 结果语义同 verify-pairing-code
    biometric-authenticate: func() -> result<bool, string>;
    /// 引擎事实：宿主当前是否持有认证凭据（JWT）。供插件激活期对账
    /// （事件不重放，状态以引擎事实为准）
    has-credentials: func() -> result<bool, string>;
}

world cap-auth-client {
    import host-auth-client;
}
