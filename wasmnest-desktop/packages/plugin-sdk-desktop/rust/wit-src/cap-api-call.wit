package wasmnest:api-call@0.0.1;

// 桌面端能力域分片（WIT 按包拆分，ADR 0061）：一个能力域 = 一个独立包，
// 版本独立演进——本包 WIT 变更只 bump 本包，不波及未 import 它的应用。
// 端 `plugin` world 经 `include wasmnest:api-call/cap-api-call@0.0.1;` 并入本接口。

/// 插件互调（ADR-0017）：发布 JSON-RPC 请求 + 同步等待回复
interface host-api-call {
    /// 发布请求到 request-topic（宿主按 `wasmnest.api.*` 门禁校验目标 api
    /// 已被某激活插件声明，未声明拒绝），并按调用方插件 ID + 请求载荷中的
    /// 字符串 `id` 构造响应 topic（`wasmnest.api.reply.<caller-id>.<request-id>`），
    /// 宿主侧注册静态回复订阅 + 阻塞等待（调用方 wasm 实例阻塞期间无法接收
    /// on_message，回复必须宿主侧消费，见 SDK api_call 模块注释）。
    /// 返回回复 JSON 字符串（result | error 对象）；超时/门禁拒绝返回错误。
    call: func(request-topic: string, payload-json: string, timeout-ms: u64) -> result<string, string>;
}

world cap-api-call {
    import host-api-call;
}
