package wasmnest:fs-desktop@0.0.1;

// 桌面端能力域分片（WIT 按包拆分，ADR 0061）：一个能力域 = 一个独立包，
// 版本独立演进——本包 WIT 变更只 bump 本包，不波及未 import 它的应用。
// 端 `plugin` world 经 `include wasmnest:fs-desktop/cap-fs-desktop@0.0.1;` 并入本接口。

/// 文件浏览域桌面扩展（v36 自 `host-fs` 拆出，双端交集切片——桌面独有 3 函数；
/// `host-fs` 交集 6 函数已收拢进共享核心 core.wit）。
/// 注：原 `host-events-desktop`（notify）已随 2026-10-13 功能级统一整 interface
/// 退役（notify 本体迁共享域契约 `wasmnest-notify-engine/wit/notify.wit` 的
/// `host-notify`；桌面实现落宿主路径 B 模块 `src-tauri/src/plugin/notify.rs`）。
interface host-fs-desktop {
    /// v19 函数级追加（文件浏览域）：目录直读。
    /// 返回 JSON 数组 `[{name, nodeType}]`——`nodeType` ∈ `"folder" | "file" |
    /// "other"`（宿主 `DirEntry::file_type` 语义：symlink / 特殊条目为 "other"，
    /// 与宿主 scan_dir 跳过「非目录非文件」条目一致）。权限 `fs:read` + fs_auth。
    read-dir: func(path: string) -> result<string, string>;
    /// v19：canonicalize 绝对路径（symlink 解析后的真实路径）；路径不存在返回
    /// `ok(none)`（宿主 `Path::canonicalize` 失败即 None，不报错）。
    /// 权限 `fs:read` + fs_auth。
    canonicalize: func(path: string) -> result<option<string>, string>;
    /// v19：文件元数据 JSON `{size, isFile, isDir}`；路径不存在返回 `ok(none)`。
    /// 权限 `fs:read` + fs_auth。
    stat: func(path: string) -> result<option<string>, string>;
}

world cap-fs-desktop {
    import host-fs-desktop;
}
