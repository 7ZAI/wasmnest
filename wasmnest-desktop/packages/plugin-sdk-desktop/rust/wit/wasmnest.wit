    include wasmnest:notify/cap-notify@0.0.1;
    include wasmnest:clipboard/cap-clipboard@0.0.1;
    include wasmnest:http-endpoint/cap-http-endpoint@0.0.1;
    include wasmnest:ws-server/cap-ws-server@0.0.1;
    include wasmnest:api-call/cap-api-call@0.0.1;
    include wasmnest:app/cap-app@0.0.1;
    include wasmnest:auth-center/cap-auth-center@0.0.1;
    include wasmnest:connection-registry/cap-connection-registry@0.0.1;
    include wasmnest:crypto/cap-crypto@0.0.1;
    include wasmnest:fs-desktop/cap-fs-desktop@0.0.1;
    include wasmnest:platform-desktop/cap-platform-desktop@0.0.1;
    include wasmnest:process/cap-process@0.0.1;
