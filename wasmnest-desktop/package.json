{
  "name": "wasmnest-desktop",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.2.1",
  "scripts": {
    "dev": "vite optimize && vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:fast": "vite build",
    "preview": "vite preview",
    "lint": "../node_modules/.bin/eslint . --cache --fix",
    "format": "../node_modules/.bin/prettier --write src/",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "wdio run wdio.conf.ts",
    "bench:zip": "node bench/scripts/build-bench-zip.mjs",
    "tauri": "tauri",
    "tauri:dev": "node scripts/dev-run.js",
    "tauri:build": "node scripts/tauri-build.js",
    "shell:sync": "pnpm run build:fast && node scripts/sync-shell-dist.mjs",
    "host:pack": "node scripts/package-host.mjs",
    "target:size": "node scripts/check-target-size.js",
    "target:clean": "cd src-tauri && cargo clean",
    "prebuild": "node scripts/check-target-size.js",
    "plugins:build": "node scripts/plugin-build.js --all",
    "plugins:build:frontend": "node ../scripts/app-script.mjs ai-chatbox desktop build:frontend",
    "plugins:build:rust": "node ../scripts/app-script.mjs ai-chatbox desktop build:rust",
    "plugins:dev": "node scripts/plugin-dev.js"
  },
  "dependencies": {
    "@binblink/wasmnest-plugin-sdk-desktop": "workspace:*",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "loglevel": "^1.9.2",
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-i18n": "^9.14.0",
    "vue-router": "^4.3.0",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.24",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/ui": "^3.2.7",
    "@vue/test-utils": "^2.4.5",
    "@wdio/cli": "^9.31.7",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.31.7",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/tauri-plugin": "^1.4.0",
    "@wdio/tauri-service": "^1.4.0",
    "@wdio/types": "^9.31.2",
    "autoprefixer": "^10.4.18",
    "happy-dom": "^13.6.0",
    "icon-gen": "^5.0.0",
    "png-to-icns": "^1.0.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.35",
    "postcss-html": "^2.0.0",
    "prettier": "^3.2.5",
    "sharp": "^0.34.5",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.13",
    "typescript": "^5.3.3",
    "vite": "^8.0.0",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.0.6",
    "webdriverio": "^9.31.7"
  }
}
